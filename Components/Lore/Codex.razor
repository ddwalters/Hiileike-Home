@page "/lore"
@page "/lore/entry/{EntryId:guid}"
@page "/lore/entry/{EntryId:guid}/revision/{RevisionNumber:int}"
@page "/project-notes"
@page "/project-notes/{NotesProjectId:guid}"
@page "/project-notes/entry/{EntryId:guid}"
@page "/project-notes/entry/{EntryId:guid}/revision/{RevisionNumber:int}"
@attribute [Authorize]
@layout LoreLayout
@inject LoreStore Store
@inject NavigationManager Navigation
@inject ILogger<Codex> Logger
@inject AuthenticationStateProvider Authentication
@inject ProjectNotesWorkspace ProjectNotes
@inject PlannerStore Planner
@using HiileikeHome.Components.Planner
@using System.Security.Claims

<PageTitle>@(Selected?.Title is { } title ? $"{title} · Project Notes" : "Project Notes")</PageTitle>

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="@(IsNotesIndex ? null : "/project-notes")">
            <span class="brand-mark"><LoreIcon Name="book" Size="24" /></span>
            <span><strong>Project Notes</strong><small>HIILĒIKE HOME</small></span>
        </a>
        <nav aria-label="Project Notes">
            @if (IsNotesIndex)
            {
                <a href="/planner/projects" class="nav-item">
                    <LoreIcon Name="Quest" Size="17" /><span>Planner projects</span>
                </a>
            }
            else
            {
                <a href="/project-notes" class="nav-item">
                    <LoreIcon Name="back" Size="17" /><span>All project notes</span>
                </a>
            }
            @if (project is { } current)
            {
                <p class="nav-caption">@current.Name</p>
                <a href="@ProjectUrl(current.Id)" class="@NavClass(null)" aria-current="@(CategoryFilter is null && !UncategorizedOnly && EntryId is null ? "page" : null)"
                   @onclick="ResetFilters">
                    <LoreIcon Name="grid" Size="17" /><span>All notes</span><small>@BrowsableEntries.Length</small>
                </a>
                @foreach (var (catalogId, category) in VisibleCategories)
                {
                    <a href="@ProjectUrl(current.Id, category.Id)" class="@NavClass(category.Id)"
                       aria-current="@(CategoryFilter?.Id == category.Id && EntryId is null ? "page" : null)">
                        <LoreIcon Name="@category.IconName" Size="17" />
                        <span>@category.Name
                            @if (catalogId != current.Id)
                            {
                                <span class="notes-source">@CatalogProject(catalogId)?.Name</span>
                            }
                        </span>
                        <small>@BrowsableEntries.Count(entry => access.ProjectFor(entry) == catalogId && entry.EffectiveCategoryId == category.Id)</small>
                    </a>
                }
                <a href="@UncategorizedUrl(current.Id)" class="@(UncategorizedOnly ? "nav-item notes-category-nav active" : "nav-item notes-category-nav")"
                   aria-current="@(UncategorizedOnly && EntryId is null ? "page" : null)">
                    <LoreIcon Name="book" Size="17" /><span>Uncategorized</span>
                    <small>@BrowsableEntries.Count(entry => entry.EffectiveCategoryId is null)</small>
                </a>
            }
        </nav>
    </aside>

    <div class="workspace">
        <header class="topbar">
            <div class="crumb">
                <LoreIcon Name="book" Size="16" />
                <a href="/planner">Planner</a>
                <b>/</b>
                @if (IsNotesIndex)
                {
                    <span aria-current="page">Project Notes</span>
                }
                else
                {
                    <a href="/project-notes">Project Notes</a>
                }
                @if (project is { } breadcrumbProject)
                {
                    <b>/</b><a href="@ProjectUrl(breadcrumbProject.Id)">@breadcrumbProject.Name</a>
                }
            </div>
            @if (project is not null && editing is null && !quickCapture && !loading)
            {
                <div class="actions topbar-actions">
                    <button class="button" @onclick="() => quickCapture = true">Quick capture</button>
                    <button class="button primary" @onclick="NewEntry"><LoreIcon Name="plus" Size="18" /> New note</button>
                </div>
            }
        </header>
        <main class="content">
            @if (error is not null)
            {
                <p class="notice error" role="alert">@error</p>
            }
            @if (loading)
            {
                <p class="muted" role="status">Loading Project Notes…</p>
            }
            else if (editing is not null)
            {
                <EntryEditor @key="editing.Id" Entry="editing" Candidates="Candidates" KnownTags="AllTags" Scope="access"
                             Categories="@CategoriesFor(access.ProjectFor(editing))" ProjectName="@project?.Name"
                             EntryProjectName="@(entry => CatalogProject(access.ProjectFor(entry))?.Name)"
                             Saved="Saved" Closed="CancelEdit" CatalogChanged="Refresh" />
            }
            else if (quickCapture)
            {
                <QuickEntry ProjectId="PrimaryCatalog" InitialCategory="NewNoteCategory" Categories="@CategoriesFor(PrimaryCatalog)"
                            Scope="access" Saved="Saved" Cancelled="() => quickCapture = false" />
            }
            else if (Selected is { } entry)
            {
                <a class="back-link" href="@ListUrl"><LoreIcon Name="back" Size="16" /> Back to notes</a>
                @if (historical is not null)
                {
                    <p class="notice">Viewing revision @entry.Revision. <a class="back-link" href="@EntryUrl(entry.Id)">View current entry</a></p>
                }
                <div class="page-title">
                    <div>
                        <div class="detail-type @entry.Kind">
                            <span class="kind-chip"><LoreIcon Name="@entry.IconName" Size="19" /></span>
                            <span class="eyebrow">@(historical is null ? DisplayCategory(entry) : entry.CategoryLabel)</span>
                            @if (entry.CatalogId == NoteCatalog.LegacyId)
                            {
                                <small class="muted">Shared note</small>
                            }
                            <span class="status @entry.Status">@entry.Status.Label()</span>
                            @if (entry.Pinned)
                            {
                                <span class="pin" title="Pinned"><LoreIcon Name="pin" Size="17" /></span>
                            }
                        </div>
                        <h1>@entry.Title</h1>
                        @if (entry.Summary.Length > 0)
                        {
                            <p class="muted">@entry.Summary</p>
                        }
                    </div>
                    @if (historical is null)
                    {
                        <button class="button" @onclick="() => Edit(entry)"><LoreIcon Name="edit" Size="17" /> Edit note</button>
                    }
                </div>
                <div class="detail-grid">
                    <div class="stack">
                        <section class="panel note-panel">
                            <h2>Notes &amp; ideas</h2>
                            <NoteText Value="@entry.Notes" />
                        </section>
                        <section class="panel note-panel">
                            <h2>Implementation notes</h2>
                            <NoteText Value="@entry.Implementation" EmptyText="No implementation notes yet." />
                        </section>
                        <section class="panel note-panel">
                            <h2><LoreIcon Name="image" /> Pictures <small>@entry.Pictures.Length</small></h2>
                            @if (entry.Pictures.Length == 0)
                            {
                                <p class="muted">No pictures attached.</p>
                            }
                            else
                            {
                                <div class="gallery">
                                    @foreach (var picture in entry.Pictures)
                                    {
                                        var url = $"/lore/pictures/{picture.Id}";
                                        <a href="@url" target="_blank" rel="noopener" title="Open full-size picture">
                                            <img src="@url" alt="@picture.Name" loading="lazy" />
                                            <span>@picture.Name</span>
                                        </a>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                    <div class="stack">
                        @if (historical is null)
                        {
                            <NoteLinks @key="entry.Id" Entry="entry" Entries="entries" Workspace="workspace" Scope="access"
                                       Busy="savingLink" Changed="ChangeLink" />
                        }
                        else
                        {
                        <section class="panel note-panel">
                            @{ var links = VisibleLinks(entry); }
                            <h2><LoreIcon Name="link" /> Linked entries <small>@links.Length</small></h2>
                            @if (links.Length == 0)
                            {
                                <p class="muted">No linked entries yet.</p>
                            }
                            @foreach (var link in links)
                            {
                                if (entries.Any(other => other.Id == link.Id))
                                {
                                    <a class="related @link.Kind" href="@EntryUrl(link.Id)">
                                        <span class="kind-chip"><LoreIcon Name="@link.IconName" Size="16" /></span>
                                        <span><strong>@link.Title</strong><small>@link.CategoryLabel</small></span>
                                        <LoreIcon Name="arrow" Size="16" />
                                    </a>
                                }
                                else
                                {
                                    <div class="related @link.Kind">
                                        <span class="kind-chip"><LoreIcon Name="@link.IconName" Size="16" /></span>
                                        <span><strong>@link.Title</strong><small>@link.CategoryLabel · Deleted</small></span>
                                    </div>
                                }
                            }
                        </section>
                        }
                        <section class="panel note-panel">
                            <h2>Revision history <small>@revisions.Length</small></h2>
                            <nav class="revision-list" aria-label="Entry revisions">
                                @foreach (var version in revisions.Reverse())
                                {
                                    var saved = version.Entry;
                                    var isCurrent = saved.Revision == revisions[^1].Entry.Revision;
                                    var isSelected = saved.Revision == entry.Revision;
                                    <a class="related revision-link" aria-current="@(isSelected ? "page" : null)"
                                       href="@(isCurrent ? EntryUrl(entry.Id) : RevisionUrl(entry.Id, saved.Revision))">
                                        <span>
                                            <strong>Revision @saved.Revision @(isCurrent ? "· Current" : null)</strong>
                                            <small>@saved.Updated.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</small>
                                        </span>
                                    </a>
                                }
                            </nav>
                        </section>
                        <section class="panel note-panel">
                            <h2>Entry details</h2>
                            <div class="tags">
                                @foreach (var tag in entry.Tags)
                                {
                                    <span class="tag">@tag</span>
                                }
                                @if (entry.Tags.Length == 0)
                                {
                                    <p class="muted">No tags.</p>
                                }
                            </div>
                            <p class="muted updated">Updated @entry.Updated.ToLocalTime().ToString("MMM d, yyyy")</p>
                            @if (historical is not null)
                            {
                                <p class="muted">Past revisions are read-only.</p>
                            }
                            else if (moving)
                            {
                                <form class="edit-section" @onsubmit="() => MoveEntry(entry)" @onsubmit:preventDefault>
                                    <div>
                                        <label for="note-move-project">Destination project</label>
                                        <select id="note-move-project" required @bind="moveProject" @bind:after="ResetMoveCategory">
                                            <option value="">Choose a project</option>
                                            @foreach (var destination in workspace.ProjectTree().Select(item => item.Project)
                                                .Where(destination => destination.Id != access.ProjectFor(entry)))
                                            {
                                                <option value="@destination.Id">@destination.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label for="note-move-category">Destination category</label>
                                        <select id="note-move-category" @bind="moveCategory">
                                            <option value="">Uncategorized</option>
                                            @foreach (var category in CategoriesFor(moveProject ?? Guid.Empty))
                                            {
                                                <option value="@category.Id">@category.Name</option>
                                            }
                                        </select>
                                    </div>
                                    @if (entry.CatalogId == NoteCatalog.LegacyId)
                                    {
                                        <p class="muted">This moves the note in your workspace. Its shared access stays the same.</p>
                                    }
                                    <div class="actions">
                                        <button type="submit" class="button primary" disabled="@(moveProject is null)">Move note</button>
                                        <button type="button" class="button" @onclick="() => moving = false">Cancel</button>
                                    </div>
                                </form>
                            }
                            else if (confirmDelete)
                            {
                                <p class="muted">Delete this entry, all its revisions, and its pictures?</p>
                                <div class="actions">
                                    <button class="button small" @onclick="() => confirmDelete = false">Cancel</button>
                                    <button class="button small danger" @onclick="() => Delete(entry)">Delete entry</button>
                                </div>
                            }
                            else
                            {
                                <div class="actions">
                                    @if (workspace.Projects.Any(destination => destination.Id != access.ProjectFor(entry)))
                                    {
                                        <button class="button small" @onclick="BeginMove">Move note</button>
                                    }
                                    <button class="button small danger" @onclick="() => confirmDelete = true">Delete entry</button>
                                </div>
                            }
                        </section>
                    </div>
                </div>
            }
            else if (EntryId is not null)
            {
                <div class="panel empty">
                    <span class="empty-icon"><LoreIcon Name="book" Size="28" /></span>
                    @if (RevisionNumber is not null && entries.Any(other => other.Id == EntryId))
                    {
                        <h1>Revision unavailable</h1>
                        <p class="muted">This revision could not be found.</p>
                        <a class="button" href="@EntryUrl(EntryId.Value)">View current entry</a>
                    }
                    else
                    {
                        <h1>Note unavailable</h1>
                        <p class="muted">This note could not be found in Project Notes.</p>
                        <a class="button" href="@ListUrl">Back to notes</a>
                    }
                </div>
            }
            else if (project is null)
            {
                var collections = workspace.ProjectTree().Select(item => (Collection: ProjectNoteCollection.For(item.Project), item.Depth, Archived: false))
                    .Concat(workspace.ArchivedNoteCollections.OrderBy(item => item.Name).Select(item => (Collection: item, Depth: 0, Archived: true)))
                    .ToArray();
                <div class="page-title">
                    <div><h1>@(NotesProjectId is null ? "Project Notes" : "Project unavailable")</h1></div>
                </div>
                @if (collections.Length == 0)
                {
                    <div class="panel empty">
                        <p class="muted">Create a project to start taking notes.</p>
                        <a class="button primary" href="/planner/projects?new=1"><LoreIcon Name="plus" Size="18" /> Create a project</a>
                    </div>
                }
                else
                {
                    var entriesByCatalog = error is null ? entries.ToLookup(access.ProjectFor) : null;
                    <div class="panel notes-project-list">
                        @foreach (var (item, depth, archived) in collections)
                        {
                            <a class="related" href="@ProjectUrl(item.Id)" style="@($"--notes-depth: {Math.Min(depth, 5)}")">
                                <LoreIcon Name="book" Size="18" />
                                <span><strong>@item.Name</strong>
                                    @if (archived)
                                    {
                                        <small class="muted">Deleted project</small>
                                    }
                                    else if (workspace.IsProjectArchived(item.Id))
                                    {
                                        <small class="muted">Archived project</small>
                                    }
                                </span>
                                @if (entriesByCatalog is not null)
                                {
                                    var count = VisibleCatalogsFor(item).Sum(id => entriesByCatalog[id].Count());
                                    <small class="notes-project-count">@count @(count == 1 ? "note" : "notes")</small>
                                }
                                <LoreIcon Name="arrow" Size="16" />
                            </a>
                        }
                    </div>
                }
            }
            else
            {
                var visibleEntries = VisibleEntries;
                <section class="hero">
                    <div>
                        <p class="eyebrow"><span></span> PROJECT NOTES</p>
                        <h1>@project.Name</h1>
                        @if (workspace.Project(project.Id) is not null)
                        {
                            <a class="back-link" href="@($"/planner/projects/{project.Id}")">View project <LoreIcon Name="arrow" Size="15" /></a>
                        }
                    </div>
                    <div class="hero-emblem" aria-hidden="true">
                        <svg viewBox="0 0 230 170" fill="none">
                            <circle cx="117" cy="85" r="70" /><circle cx="117" cy="85" r="53" />
                            <path d="M117 6v158M38 85h158M61 29l112 112M173 29 61 141" class="chart-guides" />
                            <path d="m117 24 13 47 48 14-48 14-13 47-14-47-47-14 47-14z" />
                            <path d="m117 24 1 61 60 0m-60 0-1 61m1-61H56" />
                            <path d="m80 48 23 23m27 0 24-23m-24 51 24 23m-51-23-23 23" />
                            <circle cx="117" cy="85" r="4" class="chart-center" />
                            <path d="M30 44v12m-6-6h12m166 66v10m-5-5h10M174 14v8m-4-4h8" class="chart-stars" />
                        </svg>
                    </div>
                </section>

                <section class="browser" aria-labelledby="entries-heading">
                    <div class="list-heading">
                        <div><h2 id="entries-heading">@(UncategorizedOnly ? "Uncategorized" : CategoryFilter?.Name ?? "All notes")</h2><span class="count">@visibleEntries.Length</span></div>
                        @if (HasFilters)
                        {
                            <button class="button small" @onclick="ResetFilters">Clear filters</button>
                        }
                    </div>
                    <div class="notes-options actions">
                        @if (workspace.Children(project.Id).Any())
                        {
                            <label class="checkbox">
                                <input type="checkbox" checked="@project.IncludeSubprojectNotes" @onchange="ToggleSubprojects" disabled="@savingSettings" />
                                Include subproject notes
                            </label>
                        }
                        <button type="button" class="button small" aria-expanded="@manageCategories" @onclick="ToggleCategories">Manage categories</button>
                        @if (hasDraftToRecover)
                        {
                            <button type="button" class="button small" @onclick="RecoverDraft">Recover saved draft</button>
                        }
                    </div>
                    <label class="notes-mobile-category">
                        <span>Category</span>
                        <select value="@(UncategorizedOnly ? "uncategorized" : CategoryFilter?.Id.ToString())" @onchange="NavigateCategory">
                            <option value="">All categories</option>
                            @foreach (var (catalogId, category) in VisibleCategories)
                            {
                                var owner = CatalogProject(catalogId);
                                <option value="@category.Id">@(owner is not null && owner.Id != project.Id
                                    ? $"{category.Name} · {owner.Name}" : category.Name)</option>
                            }
                            <option value="uncategorized">Uncategorized</option>
                        </select>
                    </label>
                    @if (manageCategories)
                    {
                        <form class="panel edit-section notes-categories" aria-label="Manage categories"
                              @onsubmit="SaveCategory" @onsubmit:preventDefault>
                            <p class="muted">Categories for @project.Name</p>
                            <div class="field-grid">
                                <label>Category to edit
                                    <select @bind="categoryToEdit" @bind:after="ChooseCategory">
                                        <option value="">New category</option>
                                        @foreach (var category in CategoriesFor(PrimaryCatalog))
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    </select>
                                </label>
                                @if (!deletingCategory)
                                {
                                    <label>Category name <input required maxlength="64" @bind="categoryName" /></label>
                                }
                            </div>
                            @if (deletingCategory)
                            {
                                <label>Move notes in @expectedCategoryName to
                                    <select @bind="replacementCategory">
                                        <option value="">Uncategorized</option>
                                        @foreach (var destination in CategoriesFor(PrimaryCatalog).Where(item => item.Id != categoryToEdit))
                                        {
                                            <option value="@destination.Id">@destination.Name</option>
                                        }
                                    </select>
                                </label>
                                <div class="actions">
                                    <button type="button" class="button danger" @onclick="DeleteCategory">Delete category</button>
                                    <button type="button" class="button" @onclick="() => deletingCategory = false">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <div class="actions">
                                    <button type="submit" class="button primary">@(categoryToEdit is null ? "Add category" : "Save category")</button>
                                    @if (categoryToEdit is not null)
                                    {
                                        <button type="button" class="button danger" @onclick="() => deletingCategory = true">Delete category…</button>
                                    }
                                    <button type="button" class="button" @onclick="ToggleCategories">Close</button>
                                </div>
                            }
                        </form>
                    }
                    <div class="filters">
                        <div class="search">
                            <LoreIcon Name="search" Size="19" />
                            <input aria-label="Search entries" type="search" @bind="search" @bind:event="oninput" placeholder="Search titles, notes, and tags…" />
                        </div>
                        <select aria-label="Filter by implementation status" @bind="statusFilter">
                            <option value="">All statuses</option>
                            @foreach (var status in Enum.GetValues<EntryStatus>())
                            {
                                <option value="@status">@status.Label()</option>
                            }
                        </select>
                        <select aria-label="Filter by tag" @bind="tagFilter">
                            <option value="">All tags</option>
                            @foreach (var tag in AllTags)
                            {
                                <option value="@tag">@tag</option>
                            }
                        </select>
                        <select aria-label="Sort entries" @bind="sort">
                            <option value="recent">Recently updated</option>
                            <option value="title">Title A–Z</option>
                            <option value="status">Implementation status</option>
                        </select>
                    </div>

                    @if (visibleEntries.Length > 0)
                    {
                        <div class="entry-grid">
                            @foreach (var item in visibleEntries)
                            {
                                <EntryCard @key="item.Id" Entry="item" Href="@EntryUrl(item.Id)"
                                           ProjectName="@(CatalogProject(item.CatalogId) is { } owner && owner.Id != project.Id ? owner.Name : null)" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="panel empty">
                            <span class="empty-icon"><LoreIcon Name="book" Size="28" /></span>
                            <h3>@(HasFilters ? "No notes match these filters" : "No notes here yet")</h3>
                            <p class="muted">@(HasFilters ? "Try a different search or clear the filters." : $"Add a note to {project.Name}.")</p>
                            <div class="actions">
                                @if (HasFilters)
                                {
                                    <button class="button" @onclick="ResetFilters">Clear filters</button>
                                }
                                else
                                {
                                    <button class="button primary" @onclick="NewEntry"><LoreIcon Name="plus" Size="18" /> Create a note</button>
                                }
                            </div>
                        </div>
                    }
                </section>
            }
        </main>
    </div>
</div>

@code {
    [Parameter] public Guid? EntryId { get; set; }
    [Parameter] public int? RevisionNumber { get; set; }
    [Parameter] public Guid? NotesProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? KindQueryValue { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? NoteCategoryId { get; set; }

    private PlannerWorkspace workspace = new();
    private ProjectNoteCollection? project;
    private ClaimsPrincipal user = new();
    private NoteScope access = new(new HashSet<Guid>());
    private IReadOnlySet<Guid> visibleCatalogs = new HashSet<Guid>();
    private Dictionary<Guid, NoteCategory[]> categories = [];
    private IReadOnlyDictionary<Guid, Guid> categoryAliases = new Dictionary<Guid, Guid>();
    private Dictionary<Guid, Dictionary<Guid, Guid?>> categoryReplacements = [];
    private LoreEntry[] entries = [];
    private LoreRevision[] revisions = [];
    private LoreRevision? historical;
    private LoreEntry? editing;
    private bool quickCapture, loading, manageCategories, savingSettings, hasDraftToRecover;
    private string? error;
    private Guid? categoryToEdit;
    private string categoryName = "";
    private string? expectedCategoryName;
    private string search = "";
    private string statusFilter = "";
    private string tagFilter = "";
    private string sort = "recent";
    private bool confirmDelete, moving, deletingCategory, savingLink;
    private Guid? moveProject, moveCategory, replacementCategory;

    private bool IsNotesIndex => project is null && NotesProjectId is null && EntryId is null;
    private Guid PrimaryCatalog => project?.Id ?? Guid.Empty;
    private LoreEntry[] BrowsableEntries => entries.Where(entry => visibleCatalogs.Contains(access.ProjectFor(entry))).ToArray();
    private IEnumerable<(Guid CatalogId, NoteCategory Category)> VisibleCategories => visibleCatalogs.Select(access.ProjectFor).Distinct()
        .OrderBy(id => id != PrimaryCatalog).ThenBy(id => CatalogProject(id)?.Name, StringComparer.OrdinalIgnoreCase)
        .SelectMany(id => CategoriesFor(id).Select(category => (id, category)));
    private NoteCategory? CategoryFilter => ResolveRequestedCategory() is { } id
        ? VisibleCategories.Select(item => item.Category).FirstOrDefault(category => category.Id == id) : null;
    private bool UncategorizedOnly => NoteCategoryId == "uncategorized"
        || RequestedCategory is not null && ResolveRequestedCategory() is null;
    private Guid? RequestedCategory => Guid.TryParse(NoteCategoryId, out var id) ? id : LegacyCategoryFilter;
    private Guid? LegacyCategoryFilter => visibleCatalogs.Contains(NoteCatalog.LegacyId)
        && Enum.TryParse<EntryKind>(KindQueryValue, out var kind) ? NoteCatalog.LegacyCategory(kind)?.Id : null;
    private string CategoryQuery => UncategorizedOnly ? "?category=uncategorized"
        : CategoryFilter is { } category ? $"?category={category.Id}" : "";
    private Guid? NewNoteCategory => CategoriesFor(PrimaryCatalog).Any(item => item.Id == CategoryFilter?.Id) ? CategoryFilter?.Id : null;
    private string ListUrl => project is null ? "/project-notes" : ProjectUrl(project.Id) + CategoryQuery;
    private LoreEntry? CurrentEntry => entries.FirstOrDefault(entry => entry.Id == EntryId);
    private LoreEntry? Selected => RevisionNumber is null ? CurrentEntry : historical?.Entry;
    private LoreEntry[] Candidates => editing is null ? [] : entries.Where(entry => entry.Id != editing.Id).ToArray();
    private bool HasFilters => search.Trim().Length > 0 || statusFilter.Length > 0 || tagFilter.Length > 0;
    private IEnumerable<string> AllTags => BrowsableEntries.SelectMany(entry => entry.Tags)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);

    private Guid? ResolveRequestedCategory()
    {
        if (RequestedCategory is not { } id)
            return null;
        if (VisibleCategories.Any(item => item.Category.Id == id))
            return id;
        if (visibleCatalogs.Contains(NoteCatalog.LegacyId))
            id = categoryAliases.GetValueOrDefault(id, id);
        foreach (var projectId in visibleCatalogs.Select(access.ProjectFor).Distinct())
            if (categoryReplacements.GetValueOrDefault(projectId)?.TryGetValue(id, out var replacement) == true)
                return replacement;
        return id;
    }

    private LoreEntry[] VisibleEntries
    {
        get
        {
            var terms = search.Split(' ', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
            var category = CategoryFilter;
            var filtered = BrowsableEntries.Where(entry =>
                (UncategorizedOnly ? entry.EffectiveCategoryId is null : category is null || entry.EffectiveCategoryId == category.Id)
                && (statusFilter.Length == 0 || entry.Status.ToString() == statusFilter)
                && (tagFilter.Length == 0 || entry.Tags.Contains(tagFilter, StringComparer.OrdinalIgnoreCase))
                && terms.All(term => Matches(entry, term)));
            var pinnedFirst = filtered.OrderByDescending(entry => entry.Pinned);
            return (sort switch
            {
                "title" => pinnedFirst.ThenBy(entry => entry.Title, StringComparer.OrdinalIgnoreCase),
                "status" => pinnedFirst.ThenBy(entry => entry.Status).ThenBy(entry => entry.Title, StringComparer.OrdinalIgnoreCase),
                _ => pinnedFirst.ThenByDescending(entry => entry.Updated).ThenBy(entry => entry.Title, StringComparer.OrdinalIgnoreCase)
            }).ToArray();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        editing = null;
        quickCapture = false;
        confirmDelete = false;
        moving = false;
        manageCategories = false;
        deletingCategory = false;
        error = null;
        loading = true;
        try
        {
            user = (await Authentication.GetAuthenticationStateAsync()).User;
            workspace = await ProjectNotes.ReadAsync(user);
            access = ProjectNotesWorkspace.Access(workspace);
            Refresh();
        }
        catch (Exception ex) when (IsStorageError(ex) || ex is PlannerValidationException)
        {
            project = null;
            entries = [];
            revisions = [];
            historical = null;
            workspace = new();
            Logger.LogError(ex, "Could not load the projects for Project Notes");
            error = "Project Notes could not load the project list. Reload to try again.";
        }
        finally
        {
            loading = false;
        }
    }

    private static bool Matches(LoreEntry entry, string term) =>
        entry.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
        || entry.Summary.Contains(term, StringComparison.OrdinalIgnoreCase)
        || entry.Notes.Contains(term, StringComparison.OrdinalIgnoreCase)
        || entry.Implementation.Contains(term, StringComparison.OrdinalIgnoreCase)
        || entry.CategoryLabel.Contains(term, StringComparison.OrdinalIgnoreCase)
        || entry.Tags.Any(tag => tag.Contains(term, StringComparison.OrdinalIgnoreCase));

    private string NavClass(Guid? category) => !UncategorizedOnly && CategoryFilter?.Id == category
        ? "nav-item notes-category-nav active" : "nav-item notes-category-nav";

    private static string ProjectUrl(Guid id, Guid? category = null) =>
        category is { } filter ? $"/project-notes/{id}?category={filter}" : $"/project-notes/{id}";

    private static string UncategorizedUrl(Guid id) => ProjectUrl(id) + "?category=uncategorized";

    private void NavigateCategory(ChangeEventArgs args)
    {
        if (project is { } current)
            Navigation.NavigateTo(args.Value?.ToString() == "uncategorized" ? UncategorizedUrl(current.Id)
                : ProjectUrl(current.Id, Guid.TryParse(args.Value?.ToString(), out var id) ? id : null));
    }

    private string EntryUrl(Guid id) => $"/project-notes/entry/{id}{CategoryQuery}";
    private string RevisionUrl(Guid id, int revision) => $"/project-notes/entry/{id}/revision/{revision}{CategoryQuery}";

    private LoreLink[] VisibleLinks(LoreEntry entry) => (historical?.Links
        ?? entries.Where(other => entry.Links.Contains(other.Id))
            .Select(other => other.LinkSnapshot()))
        .OrderBy(link => link.Title, StringComparer.OrdinalIgnoreCase).ToArray();

    private void ResetFilters() => search = statusFilter = tagFilter = "";

    private ProjectNoteCollection? CatalogProject(Guid id) => ProjectNotesWorkspace.FindCollection(workspace, id);
    private NoteCategory[] CategoriesFor(Guid id) => categories.GetValueOrDefault(id) ?? [];
    private string DisplayCategory(LoreEntry entry) => CategoriesFor(access.ProjectFor(entry))
        .FirstOrDefault(category => category.Id == entry.EffectiveCategoryId)?.Name ?? entry.CategoryLabel;

    private IReadOnlySet<Guid> VisibleCatalogsFor(ProjectNoteCollection item) => ProjectNotesWorkspace.CatalogIds(
        item.IncludeSubprojectNotes ? workspace.ProjectTree(item.Id).Select(child => ProjectNoteCollection.For(child.Project)).Prepend(item) : [item]);

    private void UpdateVisibleCatalogs() =>
        visibleCatalogs = project is null ? new HashSet<Guid>() : VisibleCatalogsFor(project);

    private void Refresh()
    {
        try
        {
            categories = Store.Categories(access);
            categoryAliases = Store.CategoryAliases(access);
            categoryReplacements = Store.CategoryReplacements(access);
            (entries, revisions) = Store.Snapshot(EntryId, access);
            entries = entries.Select(entry => entry with { CategoryName = DisplayCategory(entry) }).ToArray();
            historical = revisions.FirstOrDefault(version => version.Entry.Revision == RevisionNumber);
            project = EntryId is not null
                ? CurrentEntry is { } current ? CatalogProject(access.ProjectFor(current)) : null
                : NotesProjectId is { } id ? CatalogProject(id)
                : Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/').Equals("lore", StringComparison.OrdinalIgnoreCase)
                    ? CatalogProject(NoteCatalog.LegacyId)
                    : null;
            UpdateVisibleCatalogs();
            hasDraftToRecover = EntryId is null && project?.IncludesLegacyNotes == true && SavedDraftExists();
            if (tagFilter.Length > 0)
                tagFilter = AllTags.FirstOrDefault(tag => tag.Equals(tagFilter, StringComparison.OrdinalIgnoreCase)) ?? "";
        }
        catch (Exception ex) when (IsStorageError(ex))
        {
            entries = [];
            revisions = [];
            historical = null;
            Logger.LogError(ex, "Could not read Project Notes.");
            error = "Project Notes could not be read. Check the data directory and reload this page.";
        }
    }

    private static bool IsStorageError(Exception ex) => ex is IOException or UnauthorizedAccessException
        or System.Text.Json.JsonException or System.Data.Common.DbException;

    private bool SavedDraftExists()
    {
        try
        {
            return Store.LoadDraft(NoteCatalog.LegacyId, Guid.Empty, access) is not null;
        }
        catch (Exception ex) when (IsStorageError(ex))
        {
            Logger.LogWarning(ex, "Could not check for the saved notes draft.");
            return false;
        }
    }

    private void NewEntry() => Edit(LoreEntry.New(PrimaryCatalog, NewNoteCategory));

    private void Edit(LoreEntry entry)
    {
        error = null;
        confirmDelete = false;
        moving = false;
        editing = entry;
    }

    private void CancelEdit()
    {
        editing = null;
        Refresh();
    }

    private void Saved(LoreEntry entry)
    {
        editing = null;
        quickCapture = false;
        Refresh();
        Navigation.NavigateTo(EntryUrl(entry.Id));
    }

    private void Delete(LoreEntry entry)
    {
        error = null;
        try
        {
            Store.Delete(entry.Id, entry.Revision, access);
            Navigation.NavigateTo(ListUrl);
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex) when (IsStorageError(ex))
        {
            Logger.LogError(ex, "Could not delete lore entry {EntryId}.", entry.Id);
            error = "The entry could not be deleted.";
        }
    }

    private void BeginMove()
    {
        moveProject = moveCategory = null;
        moving = true;
    }

    private async Task ChangeLink(NoteLinks.LinkChange link)
    {
        if (savingLink || Selected is not { } entry || historical is not null)
            return;
        savingLink = true;
        error = null;
        try
        {
            if (link.Kind is { } kind)
            {
                workspace = await Planner.ChangeAsync(user, state => state.SetNoteLink(entry.Id, kind, link.Id, link.Linked));
            }
            else
            {
                var noteLinks = link.Linked ? entry.Links.Append(link.Id).Distinct().ToArray()
                    : entry.Links.Where(id => id != link.Id).ToArray();
                Store.Save(entry with { Links = noteLinks }, [], access, entry.Links);
                Refresh();
            }
        }
        catch (Exception ex) when (ex is PlannerValidationException or InvalidOperationException)
        {
            error = ex.Message;
        }
        catch (Exception ex) when (IsStorageError(ex))
        {
            Logger.LogError(ex, "Could not update a link for note {EntryId}.", entry.Id);
            error = "The link could not be updated.";
        }
        finally
        {
            savingLink = false;
        }
    }

    private void ResetMoveCategory() => moveCategory = null;

    private void MoveEntry(LoreEntry entry)
    {
        if (moveProject is not { } destination)
            return;
        error = null;
        try
        {
            Store.Move(entry.Id, entry.Revision, destination, moveCategory, access);
            moving = false;
            ResetFilters();
            Refresh();
            Navigation.NavigateTo($"/project-notes/entry/{entry.Id}");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex) when (IsStorageError(ex))
        {
            Logger.LogError(ex, "Could not move note {EntryId}.", entry.Id);
            error = "The note could not be moved.";
        }
    }

    private void ToggleCategories()
    {
        manageCategories = !manageCategories;
        categoryToEdit = null;
        ChooseCategory();
    }

    private void ChooseCategory()
    {
        deletingCategory = false;
        replacementCategory = null;
        expectedCategoryName = CategoriesFor(PrimaryCatalog).FirstOrDefault(category => category.Id == categoryToEdit)?.Name;
        categoryName = expectedCategoryName ?? "";
    }

    private void DeleteCategory()
    {
        if (categoryToEdit is not { } id || expectedCategoryName is not { } name)
            return;
        error = null;
        try
        {
            Store.DeleteCategory(PrimaryCatalog, id, name, replacementCategory, access);
            Refresh();
            categoryToEdit = null;
            ChooseCategory();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex) when (IsStorageError(ex))
        {
            Logger.LogError(ex, "Could not delete Project Notes category {CategoryId}.", id);
            error = "The category could not be deleted.";
        }
    }

    private void SaveCategory()
    {
        if (deletingCategory)
            return;
        error = null;
        try
        {
            Store.SaveCategory(PrimaryCatalog, categoryToEdit, categoryName, expectedCategoryName, access);
            Refresh();
            categoryToEdit = null;
            ChooseCategory();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex) when (IsStorageError(ex))
        {
            Logger.LogError(ex, "Could not save the Project Notes category.");
            error = "The category could not be saved.";
        }
    }

    private void RecoverDraft()
    {
        error = null;
        try
        {
            Edit(Store.CopyLegacyDraft(PrimaryCatalog, access));
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex) when (IsStorageError(ex))
        {
            Logger.LogError(ex, "Could not recover the saved notes draft.");
            error = "The saved draft could not be recovered.";
        }
    }

    private async Task ToggleSubprojects(ChangeEventArgs args)
    {
        if (project is null || savingSettings)
            return;

        var id = project.Id;
        var include = args.Value is true;
        error = null;
        savingSettings = true;
        try
        {
            workspace = await Planner.ChangeAsync(user, state =>
            {
                var current = state.Project(id) ?? throw new PlannerValidationException("This project is unavailable.");
                state.SaveProject(current with { IncludeSubprojectNotes = include }, PlannerCalendar.Today);
            });
            project = CatalogProject(id);
            UpdateVisibleCatalogs();
        }
        catch (Exception ex) when (IsStorageError(ex) || ex is PlannerValidationException)
        {
            Logger.LogError(ex, "Could not update subproject note visibility.");
            error = "The subproject notes setting could not be saved.";
        }
        finally
        {
            savingSettings = false;
        }
    }
}
