@inject LoreStore Lore
@inject IJSRuntime JS
@inject ILogger<PlannerTaskEditor> Logger

<NavigationLock ConfirmExternalNavigation="@HasChanges" OnBeforeInternalNavigation="ConfirmNavigation" />

<header class="queue-task-heading">
    @if (!editing && draft is not null)
    {
        <span class="@($"queue-state {draft.Status.ToString().ToLowerInvariant()}")">@(draft.IsInbox ? "Unassigned" : draft.Status.Label())</span>
    }
    <h2 tabindex="-1" data-task-heading>@(TaskId is null ? "New task" : draft?.Title ?? "Task unavailable")</h2>
</header>

@if (draft is null)
{
    <p class="planner-empty">This task could not be found in your workspace.</p>
}
else if (!editing)
{
    @if (draft.Status == PlannerStatus.Replaced)
    {
        <p class="planner-muted">This task was broken down during <a href="/planner/review">weekly review</a>.</p>
    }
    else
    {
        <div class="planner-actions queue-task-actions">
            @if (draft.IsOpen)
            {
                <button type="button" class="planner-button primary" disabled="@Busy" @onclick="() => Move(PlannerLane.Done)">Mark done</button>
            }
            @if (draft.Status == PlannerStatus.Open)
            {
                @if (draft.IsInbox)
                {
                    <button type="button" class="planner-button" disabled="@Busy" @onclick="() => Move(PlannerLane.Backlog)">Move to backlog</button>
                }
                else
                {
                    <button type="button" class="planner-button" disabled="@Busy" @onclick="() => Move(PlannerLane.InProgress)">Start</button>
                }
            }
            <button type="button" class="planner-button" disabled="@Busy" @onclick="BeginEditing">Edit</button>
        </div>
    }
    <dl class="queue-task-metadata">
        <div>
            <dt>Project</dt>
            <dd>
                @if (Workspace.Project(draft.ProjectId) is { } project)
                {
                    <a href="@($"/planner/projects/{project.Id}")">@project.Name</a>
                }
                else
                {
                    <span>No project</span>
                }
            </dd>
        </div>
        @if (Workspace.Milestone(draft.MilestoneId) is { } milestone)
        {
            <div><dt>Milestone</dt><dd>@milestone.Title</dd></div>
        }
        @if (draft.Due is { } dueDate)
        {
            <div><dt>Due</dt><dd class="@(draft.IsOpen && dueDate < Today ? "overdue" : null)">@dueDate.ToString("MMM d, yyyy")</dd></div>
        }
        @if (draft.Week is { } plannedWeek)
        {
            <div><dt>Planned week</dt><dd>@PlannerCalendar.Range(plannedWeek)</dd></div>
        }
    </dl>
    @if (!string.IsNullOrWhiteSpace(draft.Notes))
    {
        <section class="queue-task-section">
            <h3>Notes</h3>
            <p class="planner-notes">@draft.Notes</p>
        </section>
    }
    @if (draft.LoreIds.Length > 0)
    {
        <section class="queue-task-section">
            <h3>Linked notes</h3>
            @foreach (var id in draft.LoreIds)
            {
                if (loreEntries.FirstOrDefault(item => item.Id == id) is { } entry)
                {
                    <a class="queue-note-link" href="@($"/project-notes/entry/{id}")">@entry.Title <LoreIcon Name="arrow" Size="15" /></a>
                }
                else
                {
                    <p class="planner-muted">@(loreUnavailable ? "Linked note temporarily unavailable." : "Deleted note.")</p>
                }
            }
        </section>
    }
}
else
{
    <form class="planner-form queue-task-form" aria-label="Edit task" @onsubmit="Submit" @onsubmit:preventDefault>
        <label>Title <input maxlength="140" required @bind="title" @bind:event="oninput" @ref="titleInput" /></label>
        <label>Notes <textarea rows="4" maxlength="8000" @bind="notes" @bind:event="oninput"></textarea></label>
        <div class="planner-fields">
            <label>Project
                <select @bind="projectId" @bind:after="ProjectChanged">
                    <option value="">No project</option>
                    @foreach (var project in Workspace.Projects.OrderBy(item => item.Name))
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </label>
            <label>Milestone
                <select @bind="milestoneId" disabled="@(projectId is null)">
                    <option value="">No milestone</option>
                    @foreach (var milestone in Workspace.Milestones.Where(item => item.ProjectId == projectId).OrderBy(item => item.Due))
                    {
                        <option value="@milestone.Id">@milestone.Title</option>
                    }
                </select>
            </label>
            <label>Due date <input type="date" @bind="due" /></label>
            <div>
                <label>Planned week <input type="date" @bind="week" /></label>
                <div class="planner-actions planner-date-actions">
                    <button type="button" class="planner-link" @onclick="ScheduleThisWeek">This week</button>
                    @if (week is not null)
                    {
                        <button type="button" class="planner-link" @onclick="ClearWeek">Clear</button>
                    }
                </div>
            </div>
            <label>Status
                <select @bind="status">
                    @foreach (var option in Statuses)
                    {
                        <option value="@option">@option.Label()</option>
                    }
                </select>
            </label>
            <label>Weekly priority
                <select @bind="priority" disabled="@(week is null || status is not (PlannerStatus.Open or PlannerStatus.InProgress))">
                    <option value="0">None</option>
                    <option value="1">1 · Highest</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                </select>
            </label>
        </div>
        <label class="planner-checkbox"><input type="checkbox" @bind="hidden" /> Hide this task from the dashboard</label>
        <fieldset class="planner-lore-links">
            <legend><LoreIcon Name="link" Size="18" /> Linked notes</legend>
            @if (loreUnavailable)
            {
                <p class="planner-muted">Project Notes is temporarily unavailable.</p>
            }
            @foreach (var id in links)
            {
                var entry = loreEntries.FirstOrDefault(item => item.Id == id);
                <div class="planner-link-row" @key="id">
                    @if (entry is not null)
                    {
                        <a href="@($"/project-notes/entry/{id}")">@entry.Title <small>· @NoteContext(entry)</small></a>
                    }
                    else
                    {
                        <span>@(loreUnavailable ? "Linked entry" : "Deleted entry")</span>
                    }
                    <button type="button" class="planner-button small" aria-label="@($"Remove {entry?.Title ?? "note link"}")"
                            @onclick="() => links.Remove(id)">Remove</button>
                </div>
            }
            @if (!loreUnavailable)
            {
                <label class="planner-lore-search">Find a note
                    <input type="search" placeholder="Search Project Notes by title" @bind="search" @bind:event="oninput" />
                </label>
                @if (search.Trim().Length > 0)
                {
                    var results = loreEntries.Where(entry => !links.Contains(entry.Id)
                        && entry.Title.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)).Take(12).ToArray();
                    @if (results.Length == 0)
                    {
                        <p class="planner-muted">No unlinked entries match.</p>
                    }
                    @foreach (var entry in results)
                    {
                        <div class="planner-link-row" @key="entry.Id">
                            <span>@entry.Title <small>· @NoteContext(entry)</small></span>
                            <button type="button" class="planner-button small" aria-label="@($"Link {entry.Title}")"
                                    @onclick="() => links.Add(entry.Id)">Link</button>
                        </div>
                    }
                }
            }
        </fieldset>
        <div class="planner-actions">
            <button type="submit" class="planner-button primary" disabled="@Busy">Save task</button>
            @if (TaskId is not null)
            {
                <button type="button" class="planner-button" @onclick="CancelEditing" disabled="@Busy">Cancel</button>
            }
        </div>
    </form>
}

@code {
    private static readonly PlannerStatus[] Statuses =
        [PlannerStatus.Open, PlannerStatus.InProgress, PlannerStatus.Done, PlannerStatus.Archived];

    [Parameter] public Guid? TaskId { get; set; }
    [Parameter] public Guid? InitialProject { get; set; }
    [Parameter] public Guid? InitialMilestone { get; set; }
    [Parameter] public bool PlanThisWeek { get; set; }
    [Parameter, EditorRequired] public PlannerWorkspace Workspace { get; set; } = default!;
    [Parameter, EditorRequired] public DateOnly Today { get; set; }
    [Parameter, EditorRequired] public Func<Action<PlannerWorkspace>, string, Task<PlannerWorkspace?>> Save { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback<PlannerTask> Saved { get; set; }
    [Parameter] public bool Busy { get; set; }

    private PlannerTask? draft;
    private ElementReference titleInput;
    private string title = "", notes = "", search = "";
    private Guid? projectId, milestoneId;
    private DateOnly? due, week;
    private int priority;
    private PlannerStatus status;
    private List<Guid> links = [];
    private LoreEntry[] loreEntries = [];
    private bool loreUnavailable, loreLoaded, hidden, editing, focusEditor;

    private bool HasChanges => editing && draft is not null && (title != draft.Title || notes != draft.Notes
        || projectId != draft.ProjectId || milestoneId != draft.MilestoneId || due != draft.Due || week != draft.Week
        || priority != (draft.IsOpen ? draft.Priority : 0) || status != draft.Status || hidden != draft.HiddenFromDashboard
        || !links.SequenceEqual(draft.LoreIds));

    protected override void OnInitialized()
    {
        var project = Workspace.Project(InitialProject);
        var milestone = Workspace.Milestone(InitialMilestone);
        draft = TaskId is { } id ? Workspace.Task(id) : PlannerTask.New(project?.Id,
            milestone?.ProjectId == project?.Id ? milestone?.Id : null) with
        {
            Week = PlanThisWeek ? PlannerCalendar.WeekOf(Today) : null
        };
        if (draft is null)
            return;

        SetDraft(draft);
        editing = TaskId is null;
        if (editing || draft.LoreIds.Length > 0)
            LoadLore();
    }

    private void LoadLore()
    {
        if (loreLoaded)
            return;
        try
        {
            var scope = ProjectNotesWorkspace.CatalogIds(Workspace.Projects);
            var categories = Lore.Categories(scope);
            loreEntries = Lore.Snapshot(null, scope).Entries.Select(entry => entry with
                {
                    CategoryName = categories.GetValueOrDefault(entry.CatalogId)?
                        .FirstOrDefault(category => category.Id == entry.EffectiveCategoryId)?.Name ?? entry.CategoryLabel
                }).OrderBy(item => item.Title).ToArray();
            loreLoaded = true;
            loreUnavailable = false;
        }
        catch (Exception exception)
        {
            loreUnavailable = true;
            Logger.LogWarning(exception, "Unable to list Project Notes for Planner");
        }
    }

    private void BeginEditing()
    {
        LoadLore();
        editing = true;
        focusEditor = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusEditor)
        {
            focusEditor = false;
            await titleInput.FocusAsync();
        }
    }

    private async Task CancelEditing()
    {
        if (draft is null || HasChanges && !await ConfirmDiscard())
            return;
        SetDraft(draft);
        editing = false;
    }

    private async Task ConfirmNavigation(LocationChangingContext context)
    {
        if (HasChanges && !await ConfirmDiscard())
            context.PreventNavigation();
    }

    private ValueTask<bool> ConfirmDiscard() => JS.InvokeAsync<bool>("confirm", "Discard unsaved task changes?");

    private void SetDraft(PlannerTask task)
    {
        (title, notes, projectId, milestoneId, due, week, priority, status) =
            (task.Title, task.Notes, task.ProjectId, task.MilestoneId, task.Due, task.Week, task.IsOpen ? task.Priority : 0, task.Status);
        links = [.. task.LoreIds];
        hidden = task.HiddenFromDashboard;
        draft = task;
    }

    private void ProjectChanged() => milestoneId = null;
    private string NoteContext(LoreEntry entry) =>
        $"{ProjectNotesWorkspace.FindProject(Workspace, entry.CatalogId)?.Name} · {entry.CategoryLabel}";
    private void ScheduleThisWeek() => week = PlannerCalendar.WeekOf(Today);
    private void ClearWeek()
    {
        week = null;
        priority = 0;
    }

    private async Task Submit()
    {
        if (draft is null)
            return;

        var updated = draft with
        {
            Title = title, Notes = notes, ProjectId = projectId, MilestoneId = milestoneId, Due = due,
            Week = week is { } date ? PlannerCalendar.WeekOf(date) : null,
            Priority = week is null ? 0 : priority, Status = status, HiddenFromDashboard = hidden,
            InboxPending = draft.InboxPending,
            LoreIds = (loreUnavailable ? links : links.Where(id => loreEntries.Any(entry => entry.Id == id))).ToArray()
        };
        var today = Today;
        var saved = await Save(state => state.SaveTask(updated, today), "Task saved.");
        if (saved?.Task(updated.Id) is not { } task)
            return;

        SetDraft(task);
        editing = false;
        await Saved.InvokeAsync(task);
    }

    private async Task Move(PlannerLane lane)
    {
        if (draft is not { } previous)
            return;

        var today = Today;
        var message = lane == PlannerLane.Done ? $"Completed {previous.Title}." : $"Moved to {lane.Label()}.";
        var saved = await Save(state => state.MoveTask(previous, lane, today), message);
        if (saved?.Task(previous.Id) is { } task)
        {
            SetDraft(task);
            await Saved.InvokeAsync(task);
        }
    }
}
